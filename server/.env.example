# Salin file ini menjadi .env lalu isi key-nya. JANGAN PERNAH commit file .env.
# Buat API key di https://openrouter.ai/keys (butuh akun OpenRouter + saldo).

# API key OpenRouter (wajib). Server membacanya dari sini.
OPENROUTER_API_KEY=

# Model yang dipakai widget chat (slug dari https://openrouter.ai/models).
# Default: inclusionai/ling-3.2-flash:free (GRATIS, tanpa perlu isi saldo).
# Catatan: model gratis dibatasi OpenRouter (sekitar 50 request/hari untuk akun
# yang belum pernah isi saldo), dan kadang sibuk di sisi penyedianya — kalau
# satu model gratis sedang dibatasi, coba model gratis lain, misalnya
# google/gemma-4-31b-it:free atau nvidia/nemotron-3.5-lightning:free.
# Kalau butuh lebih, isi saldo lalu ganti ke model berbayar, misalnya
# anthropic/claude-opus-5.5 atau deepseek/deepseek-chat.
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free

# Port server (opsional, default 3000).
PORT=3000
